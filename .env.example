# Next.js Frontend Environment Variables
# Copy to .env for local development

DATABASE_URL="postgresql://user:password@localhost:5432/deetx_fashion"
DIRECT_URL="postgresql://user:password@localhost:5432/deetx_fashion"
AUTH_SECRET="your-32-character-secret-key-goes-here"

# Optional Cloudinary & Payment Gateway
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Logistics Backend API URL (default is http://localhost:5000)
BACKEND_API_URL="http://localhost:5000"
